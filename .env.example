# Optional. Without this, the app runs in demo/mock mode — fully explorable
# with zero setup, using representative extraction data.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-latest if unset.
# Check https://ai.google.dev/gemini-api/docs/models for the current free-tier
# model name before you deploy.
GEMINI_MODEL=gemini-flash-latest

# Optional embedding model. Defaults to gemini-embedding-001.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# REQUIRED before any real deployment. A long random string used to sign
# session cookies — generate with: openssl rand -base64 32
# If you leave this unset in production, sessions are signed with an insecure
# hardcoded default (fine for local dev only).
AUTH_SECRET=

# Optional: connect a real Postgres/Supabase database (see docs/OWNER_GUIDE.md
# Phase E). Without it, the app uses a local SQLite database.
DATABASE_URL=

# Optional: Google OAuth (see docs/OWNER_GUIDE.md Phase D). When both are set,
# the "Continue with Google" button appears on the sign-in screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Defaults to http://localhost:3000/api/auth/oauth/google/callback.
# Set to your production URL when deployed.
OAUTH_REDIRECT_URI=

# Optional. Base URL of the deployed app for redirects (e.g.
# https://your-app.vercel.app).
APP_URL=
